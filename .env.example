# Copie para .env (NUNCA envie .env ao GitHub). Chaves só no servidor.
# Sem configurar mais nada, o gateway usa o Ollama local com llama3.2.
AYANODE_AGENT_PORT=8787
AYANODE_DEFAULT_PROVIDER=ollama
AYANODE_DEFAULT_MODEL=llama3.2
# Limite por chamada de modelo (contém uso potencialmente cobrado).
AYANODE_MAX_OUTPUT_TOKENS=1500
OLLAMA_URL=http://127.0.0.1:11434

# Provedores opcionais para agentes distintos. Preencha somente o(s) necessário(s).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Exemplo: distribuir etapas entre provedores diferentes (ajuste modelos em sua conta).
# AYANODE_RESEARCH_PROVIDER=openai
# AYANODE_RESEARCH_MODEL=gpt-5-mini
# AYANODE_ANALYZE_PROVIDER=gemini
# AYANODE_ANALYZE_MODEL=gemini-2.5-flash
# AYANODE_WRITE_PROVIDER=ollama
# AYANODE_WRITE_MODEL=llama3.2
# AYANODE_REVIEW_PROVIDER=anthropic
# AYANODE_REVIEW_MODEL=claude-sonnet-4-5
# AYANODE_SUMMARIZE_PROVIDER=openai
# AYANODE_SUMMARIZE_MODEL=gpt-5-mini
